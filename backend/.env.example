# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Google Sheets API (Service Account) ───────────────────────────────────────
# 1. Create a Google Cloud project and enable the Google Sheets API.
# 2. Create a Service Account and download the JSON key file.
# 3. Copy the values below from that JSON key file.
# 4. Share your Google Sheet with the service account email (Editor access).

GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the private_key field from your JSON key file.
# The value starts with -----BEGIN RSA PRIVATE KEY-----
# Keep the literal \n sequences — they are converted to real newlines at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# The ID of your Google Sheet (found in the URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit)
GOOGLE_SHEET_ID=your-google-sheet-id-here

# ── Email / Resend (for the Contact form) ────────────────────────────────────
# Create an API key in your Resend dashboard and place it here.
# Never expose this key to the frontend.
RESEND_API_KEY=your-resend-api-key-here

# Optional: from-address for outgoing email (must be valid in Resend)
# CONTACT_FROM_EMAIL=onboarding@resend.dev

# Address that receives the contact form submissions.
CONTACT_EMAIL=your-gmail--id-here
